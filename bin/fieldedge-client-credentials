#!/usr/bin/env php
<?php

declare(strict_types=1);

use Compwright\OAuth2\FieldEdge\ProviderFactory;
use League\OAuth2\Client\Provider\Exception\IdentityProviderException;

if ($argc !== 4) {
    printf(
        'Usage: %s {client_id} {client_secret} {target_id}' . PHP_EOL,
        $argv[0]
    );
    exit(1);
}

list(, $clientId, $clientSecret, $target_id) = $argv;

include $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

$factory = new ProviderFactory();

$provider = $factory->new($clientId, $clientSecret);

try {
    $token = $provider->getAccessToken('client_credentials', compact('target_id'));
} catch (IdentityProviderException $e) {
    print_r($e->getResponseBody());
    exit(1);
}

print_r($token->jsonSerialize());
