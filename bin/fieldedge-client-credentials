#!/usr/bin/env php
<?php

declare(strict_types=1);

use Compwright\OAuth2\FieldEdge\ProviderFactory;

require(dirname(__DIR__) . '/vendor/autoload.php');

$factory = new ProviderFactory();

$provider = $factory->new(
    clientId: getenv('FIELDEDGE_CLIENT_ID') ?: $argv[1] ?? '',
    clientSecret: getenv('FIELDEDGE_CLIENT_SECRET') ?: $argv[2] ?? '',
);

$token = $provider->getAccessToken('client_credentials', [
    'target_id' => getenv('FIELDEDGE_TARGET_ID') ?: $argv[3] ?? '',
]);

print_r($token->jsonSerialize());
