{
    "name": "compwright/oauth2-fieldedge",
    "description": "FieldEdge OAuth 2.0 Client Provider for The PHP League OAuth2-Client",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathon Hill",
            "email": "jonathon@compwright.com",
            "homepage": "https://compwright.com"
        }
    ],
    "keywords": [
        "oauth",
        "oauth2",
        "client",
        "authorization",
        "authorisation",
        "field",
        "edge",
        "provider"
    ],
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "league/oauth2-client": "^2.5",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "guzzlehttp/guzzle": "^7.15",
        "guzzlehttp/psr7": "^2.13",
        "league/oauth2-client": "^2.5",
        "phpunit/phpunit": "^13.2",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Compwright\\OAuth2\\FieldEdge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Compwright\\OAuth2\\FieldEdge\\": "tests/"
        }
    }
}
